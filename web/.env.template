# Copy to .env.local (git-ignored).
# Data source: "mock" (built-in fake data) or "postgres" (needs `docker compose up -d` at the repo root)
RMI_DATA_SOURCE=postgres
# postgres://<user>:<password>@<host>:<port>/<database> — must match the repo-root .env
DATABASE_URL=postgres://rmi:change-me@localhost:5432/rmi
# Timezone used to bucket events into store-local hours
RMI_TZ=Asia/Bangkok
