<mxfile host="app.diagrams.net" type="device"><diagram id="er-0" name="Overview"><mxGraphModel dx="2160" dy="572" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2160" pageHeight="572" background="#FFFFFF" adaptiveColors="none" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p384_1" value='&lt;b style="font-size:26px"&gt;Database — overview&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:14px" color="#495057"&gt;PostgreSQL · 12 tables + 2 views · each area has its own tab with full columns and relationships&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="64" as="geometry"></mxGeometry></mxCell><mxCell id="p384_2" value="&lt;b&gt;1 · Site setup&lt;/b&gt;" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=15;fillColor=#DCEBFB;strokeColor=#2A78D6;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="300" height="238" as="geometry"></mxGeometry></mxCell><mxCell id="p384_3" value='&lt;b&gt;stores&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#495057"&gt;branch + timezone&lt;/font&gt;' style="rounded=1;html=1;whiteSpace=wrap;align=left;spacingLeft=10;fontSize=12;fillColor=#FFFFFF;strokeColor=#2A78D6;" vertex="1" parent="p384_2"><mxGeometry x="12" y="44" width="276" height="50" as="geometry"></mxGeometry></mxCell><mxCell id="p384_4" value='&lt;b&gt;cameras&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#495057"&gt;CAM001–003: location + video folder&lt;/font&gt;' style="rounded=1;html=1;whiteSpace=wrap;align=left;spacingLeft=10;fontSize=12;fillColor=#FFFFFF;strokeColor=#2A78D6;" vertex="1" parent="p384_2"><mxGeometry x="12" y="106" width="276" height="50" as="geometry"></mxGeometry></mxCell><mxCell id="p384_5" value="&lt;b&gt;screens&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11p